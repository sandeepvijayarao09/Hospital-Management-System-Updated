{
  "name": "server",
  "version": "1.0.0",
  "description": "Express + MongoDB API for the Hospital Management System",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "dev:memory": "USE_MEMORY_DB=true SEED_DEMO=true nodemon src/index.ts",
